---
import { ArrowLeft, Calendar, MapPin, Clock, Ticket, Share2, Music } from "lucide-react";
import { events } from "@/data/data";
import Layout from "@/layouts/Layout.astro";

import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() => {
  return events.map((event) => {
    return {
      params: { name: event.name.replace(/\s+/g, "-").toString() },
    };
  });
}) satisfies GetStaticPaths;

const { name } = Astro.params;

const event = events.find((event) => event.name.replace(/\s+/g, "-") === name);

if (!event) {
  throw new Error(`Evento no encontrado: ${name}`);
}

const formatDate = (dateString: string) => {
  const [year, month, day] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  return new Intl.DateTimeFormat("es-CR", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};

const formatShortDate = (dateString: string) => {
  const [year, month, day] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  return {
    day: date.getDate(),
    month: new Intl.DateTimeFormat("es-CR", { month: "short" }).format(date).toUpperCase(),
    year: date.getFullYear(),
  };
};

const shortDate = formatShortDate(event.date);

const hashtagsForSharing = event.social?.hashtags
  .map((tag) => tag.replace("#", ""))
  .join(",") || "";

const shareUrl =
  event.seo?.canonical ||
  `https://www.florenciaorquestaband.com/eventos/${event.name.toLowerCase().replace(/\s+/g, "-")}`;
const shareText = `🎵 ${event.name} — ${formatDate(event.date)}`;
---

<Layout
  title={event.seo?.title}
  description={event.seo?.description}
  ogImage={event.seo?.ogImage}
  keywords={event.seo?.keywords?.join(", ")}
  canonical={event.seo?.canonical}
  og={event.seo?.og}
>
  <main style="background: oklch(0.07 0.007 50); min-height: 100vh;">

    <!-- ── HERO ── -->
    <section class=`relative pt-36 ${event.image && "justify-end"}` style="min-height: 85vh; display: flex; flex-direction: column;">

      <!-- Background image -->
      {event.image ? (
        <img
          src={event.image}
          alt={event.name}
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
        />
      ) : (
        <div style="position: absolute; inset: 0; background: linear-gradient(135deg, oklch(0.18 0.04 50), oklch(0.07 0.007 50));"></div>
      )}

      <!-- Gradient overlay -->
      <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, oklch(0.07 0.007 50 / 0.55) 0%, oklch(0.07 0.007 50 / 0.5) 40%, oklch(0.07 0.007 50 / 0.85) 75%, oklch(0.07 0.007 50) 100%);"></div>

      <!-- Nav bar -->
      <div style="position: absolute; top: 0; left: 0; right: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem clamp(1.5rem, 5vw, 3rem);">
        <a
          href="/"
          class="back-link"
          style="display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: oklch(0.67 0.010 65); text-decoration: none; transition: color 0.2s ease;"
          onmouseover="this.style.color='oklch(0.83 0.155 72)';"
          onmouseout="this.style.color='oklch(0.67 0.010 65)';"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 2L4 7l5 5"/>
          </svg>
          Eventos
        </a>

        <!-- Event type badge -->
        <span
          style={`font-family: var(--font-sans); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.35rem 0.85rem; border-radius: 2px; border: 1px solid ${event.type === "Publico" ? "oklch(0.83 0.155 72 / 0.35)" : "oklch(0.67 0.010 65 / 0.3)"}; color: ${event.type === "Publico" ? "oklch(0.83 0.155 72)" : "oklch(0.67 0.010 65)"};`}
        >
          {event.type === "Publico" ? "Evento Público" : "Evento Privado"}
        </span>
      </div>

      <!-- Hero content -->
      <div style="position: relative; z-index: 10; padding: 0 clamp(1.5rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem);">
        <div style="max-width: 56rem; margin: 0 auto;">

          <!-- Date stamp -->
          <div class="hero-meta" style="display: flex; align-items: baseline; gap: 1.25rem; margin-bottom: 1.5rem; opacity: 0;">
            <div style="display: flex; align-items: baseline; gap: 0.4rem;">
              <span style="font-family: var(--font-serif); font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1; color: oklch(0.83 0.155 72);">{shortDate.day}</span>
              <div style="display: flex; flex-direction: column; gap: 0.1rem; padding-bottom: 0.3rem;">
                <span style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.83 0.155 72 / 0.8);">{shortDate.month}</span>
                <span style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.06em; color: oklch(0.42 0.008 55);">{shortDate.year}</span>
              </div>
            </div>
            <div style="width: 1px; height: 2.5rem; background: oklch(0.72 0.170 50 / 0.3);"></div>
            <span style="font-family: var(--font-sans); font-size: clamp(0.8rem, 1.5vw, 0.9rem); color: oklch(0.67 0.010 65); text-transform: capitalize;">{formatDate(event.date)}</span>
          </div>

          <!-- Title -->
          <h1
            class="hero-title"
            style="font-family: var(--font-serif); font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1.05; color: oklch(0.94 0.010 75); margin: 0 0 1.5rem; letter-spacing: -0.02em; opacity: 0;"
          >
            {event.name}
          </h1>

          <!-- Location line -->
          <div class="hero-location" style="display: flex; align-items: center; gap: 0.6rem; opacity: 0;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="oklch(0.83 0.155 72)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span style="font-family: var(--font-sans); font-size: clamp(0.85rem, 1.5vw, 1rem); color: oklch(0.67 0.010 65);">{event.location.name}</span>
          </div>

        </div>
      </div>
    </section>

    <!-- ── MAIN CONTENT ── -->
    <div style="max-width: 52rem; margin: 0 auto; padding: 0 clamp(1.5rem, 5vw, 3rem);">

      <!-- Info strip -->
      <div class="reveal" style="display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid oklch(0.22 0.016 50); border-bottom: 1px solid oklch(0.22 0.016 50); margin-top: 0; padding: clamp(1.25rem, 3vw, 2rem) 0;">
        {event.time && (
          <div style="flex: 1 1 140px; padding: 0.75rem 1.5rem 0.75rem 0; border-right: 1px solid oklch(0.22 0.016 50); margin-right: 1.5rem;">
            <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.42 0.008 55); margin: 0 0 0.35rem;">Apertura</p>
            <p style="font-family: var(--font-serif); font-size: 1.4rem; color: oklch(0.94 0.010 75); margin: 0; line-height: 1.2;">{event.time.start}</p>
          </div>
          <div style="flex: 1 1 140px; padding: 0.75rem 1.5rem 0.75rem 0; border-right: 1px solid oklch(0.22 0.016 50); margin-right: 1.5rem;">
            <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.42 0.008 55); margin: 0 0 0.35rem;">Concierto</p>
            <p style="font-family: var(--font-serif); font-size: 1.4rem; color: oklch(0.83 0.155 72); margin: 0; line-height: 1.2;">{event.time.concert}</p>
          </div>
        )}

        {event.ticket && (
          <div style="flex: 1 1 140px; padding: 0.75rem 1.5rem 0.75rem 0; border-right: 1px solid oklch(0.22 0.016 50); margin-right: 1.5rem;">
            <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.42 0.008 55); margin: 0 0 0.35rem;">{event.ticket.presale ? "Preventa desde" : "Entrada"}</p>
            <p style="font-family: var(--font-serif); font-size: 1.4rem; color: oklch(0.94 0.010 75); margin: 0; line-height: 1.2;">{event.ticket.presale?.price || event.ticket.regular.price}</p>
          </div>
        )}

        <div style="flex: 1 1 140px; padding: 0.75rem 0;">
          <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.42 0.008 55); margin: 0 0 0.35rem;">Intérprete</p>
          <p style="font-family: var(--font-serif); font-size: 1.1rem; color: oklch(0.94 0.010 75); margin: 0; line-height: 1.3;">Florencia Orquesta Band</p>
        </div>
      </div>

      <!-- Description -->
      {event.description && (
        <section class="reveal" style="padding: clamp(3rem, 6vw, 5rem) 0; border-bottom: 1px solid oklch(0.22 0.016 50);">
          <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.42 0.008 55); margin: 0 0 1.25rem;">Acerca del evento</p>
          <p style="font-family: var(--font-serif); font-size: clamp(1.1rem, 2.2vw, 1.4rem); color: oklch(0.87 0.010 70); line-height: 1.7; margin: 0; font-style: italic; max-width: 46rem;">{event.description}</p>
        </section>
      )}

      <!-- Tickets -->
      {event.ticket && (
        <section class="reveal" style="padding: clamp(3rem, 6vw, 5rem) 0; border-bottom: 1px solid oklch(0.22 0.016 50);">
          <h2 style="font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 1.9rem); color: oklch(0.94 0.010 75); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Entradas</h2>
          <div style="width: 3rem; height: 1px; background: oklch(0.83 0.155 72); margin-bottom: 2.5rem;"></div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; background: oklch(0.22 0.016 50); border: 1px solid oklch(0.22 0.016 50);">
            {event.ticket.presale && (
              <div style="background: oklch(0.07 0.007 50); padding: 2rem 1.75rem;">
                <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.83 0.155 72); margin: 0 0 0.75rem;">⚡ Preventa</p>
                <p style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.8rem); color: oklch(0.83 0.155 72); margin: 0 0 1.5rem; line-height: 1;">{event.ticket.presale.price}</p>
                {event.ticket.presale.link && (
                  <a
                    href={event.ticket.presale.link}
                    style="display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: oklch(0.83 0.155 72); text-decoration: none; border: 1px solid oklch(0.83 0.155 72 / 0.4); border-radius: 2px; padding: 0.65rem 1.25rem; transition: border-color 0.2s ease, background 0.2s ease;"
                    onmouseover="this.style.borderColor='oklch(0.83 0.155 72 / 0.8)'; this.style.background='oklch(0.83 0.155 72 / 0.08)';"
                    onmouseout="this.style.borderColor='oklch(0.83 0.155 72 / 0.4)'; this.style.background='transparent';"
                  >
                    Comprar entradas
                  </a>
                )}
              </div>
            )}

            <div style="background: oklch(0.07 0.007 50); padding: 2rem 1.75rem;">
              <p style="font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: oklch(0.42 0.008 55); margin: 0 0 0.75rem;">{event.ticket.presale ? "En taquilla" : event.ticket.type}</p>
              <p style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.8rem); color: oklch(0.94 0.010 75); margin: 0 0 1.5rem; line-height: 1;">{event.ticket.regular.price}</p>
              {event.ticket.regular.link && !event.ticket.presale && (
                <a
                  href={event.ticket.regular.link}
                  style="display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: oklch(0.72 0.170 50); text-decoration: none; border: 1px solid oklch(0.72 0.170 50 / 0.4); border-radius: 2px; padding: 0.65rem 1.25rem; transition: border-color 0.2s ease, background 0.2s ease;"
                  onmouseover="this.style.borderColor='oklch(0.72 0.170 50 / 0.8)'; this.style.background='oklch(0.72 0.170 50 / 0.08)';"
                  onmouseout="this.style.borderColor='oklch(0.72 0.170 50 / 0.4)'; this.style.background='transparent';"
                >
                  Comprar entradas
                </a>
              )}
            </div>
          </div>
        </section>
      )}

      <!-- Schedule -->
      {event.time && (
        <section class="reveal" style="padding: clamp(3rem, 6vw, 5rem) 0; border-bottom: 1px solid oklch(0.22 0.016 50);">
          <h2 style="font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 1.9rem); color: oklch(0.94 0.010 75); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Horarios</h2>
          <div style="width: 3rem; height: 1px; background: oklch(0.83 0.155 72); margin-bottom: 2.5rem;"></div>

          <div style="display: flex; flex-direction: column; gap: 0;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; padding: 1.25rem 0; border-bottom: 1px solid oklch(0.22 0.016 50);">
              <span style="font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: oklch(0.42 0.008 55);">Apertura de puertas</span>
              <span style="font-family: var(--font-serif); font-size: 1.6rem; color: oklch(0.94 0.010 75);">{event.time.start}</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; padding: 1.25rem 0; border-bottom: 1px solid oklch(0.22 0.016 50);">
              <span style="font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: oklch(0.42 0.008 55);">Inicio del concierto</span>
              <span style="font-family: var(--font-serif); font-size: 1.6rem; color: oklch(0.83 0.155 72);">{event.time.concert}</span>
            </div>
            {event.time.end && (
              <div style="display: flex; justify-content: space-between; align-items: baseline; padding: 1.25rem 0;">
                <span style="font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: oklch(0.42 0.008 55);">Cierre</span>
                <span style="font-family: var(--font-serif); font-size: 1.6rem; color: oklch(0.94 0.010 75);">{event.time.end}</span>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Location & Map -->
      <section class="reveal" style="padding: clamp(3rem, 6vw, 5rem) 0; border-bottom: 1px solid oklch(0.22 0.016 50);">
        <h2 style="font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 1.9rem); color: oklch(0.94 0.010 75); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Ubicación</h2>
        <div style="width: 3rem; height: 1px; background: oklch(0.83 0.155 72); margin-bottom: 2.5rem;"></div>

        <div style="margin-bottom: 1.5rem;">
          <p style="font-family: var(--font-serif); font-size: clamp(1.2rem, 2.5vw, 1.6rem); color: oklch(0.94 0.010 75); margin: 0 0 0.35rem;">{event.location.name}</p>
          {event.location.address && (
            <p style="font-family: var(--font-sans); font-size: 0.88rem; color: oklch(0.42 0.008 55); margin: 0;">{event.location.address}</p>
          )}
        </div>

        <div style="border: 1px solid oklch(0.22 0.016 50); overflow: hidden; border-radius: 2px; height: 22rem;">
          <iframe
            src={event.location.src}
            style="width: 100%; height: 100%; border: 0; display: block;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>

      <!-- Social Share -->
      {event.social?.hashtags && event.social.hashtags.length > 0 && (
        <section class="reveal" style="padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);">
          <h2 style="font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 1.9rem); color: oklch(0.94 0.010 75); margin: 0 0 0.6rem; letter-spacing: -0.01em;">Compartir</h2>
          <div style="width: 3rem; height: 1px; background: oklch(0.83 0.155 72); margin-bottom: 2.5rem;"></div>

          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem;">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}&hashtags=${hashtagsForSharing}`}
              target="_blank"
              rel="noopener noreferrer"
              style="display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: oklch(0.67 0.010 65); text-decoration: none; border: 1px solid oklch(0.22 0.016 50); border-radius: 2px; padding: 0.65rem 1.25rem; transition: color 0.2s ease, border-color 0.2s ease;"
              onmouseover="this.style.color='oklch(0.83 0.155 72)'; this.style.borderColor='oklch(0.83 0.155 72 / 0.4)';"
              onmouseout="this.style.color='oklch(0.67 0.010 65)'; this.style.borderColor='oklch(0.22 0.016 50)';"
            >
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              Twitter
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              style="display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: oklch(0.67 0.010 65); text-decoration: none; border: 1px solid oklch(0.22 0.016 50); border-radius: 2px; padding: 0.65rem 1.25rem; transition: color 0.2s ease, border-color 0.2s ease;"
              onmouseover="this.style.color='oklch(0.83 0.155 72)'; this.style.borderColor='oklch(0.83 0.155 72 / 0.4)';"
              onmouseout="this.style.color='oklch(0.67 0.010 65)'; this.style.borderColor='oklch(0.22 0.016 50)';"
            >
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 3.667h-3.533v7.98H9.101z"/>
              </svg>
              Facebook
            </a>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(shareText + " " + shareUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              style="display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: oklch(0.67 0.010 65); text-decoration: none; border: 1px solid oklch(0.22 0.016 50); border-radius: 2px; padding: 0.65rem 1.25rem; transition: color 0.2s ease, border-color 0.2s ease;"
              onmouseover="this.style.color='oklch(0.83 0.155 72)'; this.style.borderColor='oklch(0.83 0.155 72 / 0.4)';"
              onmouseout="this.style.color='oklch(0.67 0.010 65)'; this.style.borderColor='oklch(0.22 0.016 50)';"
            >
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
