---
import ContactForm from "@/components/ContactForm.astro";
import Layout from "@/layouts/Layout.astro";
import { MessageSquareShare } from "lucide-react";
---

<Layout
  title="Contáctanos - Florencia Orquesta Band"
  description="Contáctanos para contratar la mejor música en vivo y eventos bailables. Florencia Orquesta Band está aquí para ayudarte a hacer de tu evento una experiencia inolvidable."
  ogImage="https://florenciaorquestaband.com/hero.png"
  keywords={`
    Contactar Florencia Orquesta Band,
    Contratar orquesta San Carlos,
    Cotización orquesta Alajuela,
    Contratar música en vivo Costa Rica,
    Reservar orquesta para evento
  `}
>
  <main
    class="w-full min-h-screen py-28 px-6 lg:px-12"
    style="background: oklch(0.07 0.007 50);"
  >
    <div class="container mx-auto max-w-3xl">
      <!-- Heading -->
      <header class="mb-14">
        <h1
          class="font-serif leading-tight"
          style="font-size: clamp(2rem, 5vw, 3.2rem); color: oklch(0.83 0.155 72);"
        >
          Contacto
        </h1>
        <div class="mt-4 h-px w-16" style="background: oklch(0.72 0.170 50);"></div>
      </header>

      <!-- Copy -->
      <p
        class="font-sans mb-10 leading-relaxed"
        style="font-size: 0.95rem; color: oklch(0.67 0.010 65); max-width: 54ch;"
      >
        Podés contactar al director de la orquesta, el maestro
        <strong style="color: oklch(0.83 0.155 72); font-weight: 500;">Julio Salas</strong>,
        directamente por WhatsApp, o completar el formulario y te respondemos a la brevedad.
        Sin compromiso.
      </p>

      <!-- WhatsApp CTA -->
      <div class="mb-14">
        <a
          href="https://wa.me/+50688487681"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-6 py-3 font-sans font-medium transition-all duration-300"
          style="
            font-size: 0.9rem;
            color: oklch(0.83 0.155 72);
            border: 1px solid oklch(0.72 0.170 50 / 0.4);
            border-radius: 2px;
          "
          onmouseover="this.style.background='oklch(0.72 0.170 50 / 0.1)'; this.style.borderColor='oklch(0.72 0.170 50 / 0.8)';"
          onmouseout="this.style.background='transparent'; this.style.borderColor='oklch(0.72 0.170 50 / 0.4)';"
        >
          <MessageSquareShare className="w-4 h-4" />
          Julio Salas — WhatsApp
        </a>
      </div>

      <!-- Divider -->
      <div
        class="mb-14"
        style="height: 1px; background: oklch(0.22 0.016 50);"
      ></div>

      <!-- Form -->
      <ContactForm />
    </div>
  </main>
</Layout>
