---

<footer
  class="w-full py-12"
  style="background: oklch(0.07 0.007 50); border-top: 1px solid oklch(0.22 0.016 50);"
>
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">
      <!-- Brand -->
      <div>
        <p class="font-serif" style="font-size: 1.1rem; color: oklch(0.83 0.155 72);">
          Florencia Orquesta Band
        </p>
        <p class="font-sans mt-1" style="font-size: 0.78rem; color: oklch(0.42 0.008 55);">
          San Carlos, Alajuela, Costa Rica
        </p>
      </div>

      <!-- Links -->
      <nav class="flex items-center gap-6" aria-label="Redes sociales">
        <a
          href="https://www.facebook.com/FlorenciaOrquestaBand/"
          class="font-sans transition-colors duration-200 hover:text-fob-gold"
          style="font-size: 0.82rem; color: oklch(0.42 0.008 55); letter-spacing: 0.04em;"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>
        <a
          href="https://www.instagram.com/florenciaorquestaband/"
          class="font-sans transition-colors duration-200 hover:text-fob-gold"
          style="font-size: 0.82rem; color: oklch(0.42 0.008 55); letter-spacing: 0.04em;"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>
        <a
          href="https://wa.me/50688487681"
          class="font-sans transition-colors duration-200 hover:text-fob-gold"
          style="font-size: 0.82rem; color: oklch(0.42 0.008 55); letter-spacing: 0.04em;"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
      </nav>
    </div>

    <p
      class="font-sans mt-10"
      style="font-size: 0.72rem; color: oklch(0.30 0.018 50);"
    >
      &copy; {new Date().getFullYear()} Florencia Orquesta Band. Todos los derechos reservados.
    </p>
  </div>
</footer>
