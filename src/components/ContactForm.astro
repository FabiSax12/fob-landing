---
import ThemedButton from "@/components/ui/ThemedButton.astro";
---

<div
  class="max-w-2xl mx-auto"
>
  <h2 class="font-serif mb-8" style="font-size: clamp(1.5rem, 3vw, 2rem); color: oklch(0.83 0.155 72);">
    Envianos un mensaje
  </h2>

  <form id="contact-form" class="flex flex-col gap-5" onsubmit="handleSubmit(event)">
    <div class="form-field">
      <label for="name" class="form-label">Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="form-input"
        placeholder="Tu nombre completo"
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div class="form-field">
        <label for="email" class="form-label">Correo electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="form-input"
          placeholder="tu@correo.com"
        />
      </div>
      <div class="form-field">
        <label for="tel" class="form-label">Teléfono</label>
        <div class="flex items-center">
          <span
            class="font-sans px-3 py-[0.74rem] h-full flex-shrink-0"
            style="
              background: oklch(0.16 0.013 50);
              border: 1px solid oklch(0.22 0.016 50);
              border-right: none;
              border-radius: 2px 0 0 2px;
              font-size: 0.9rem;
              color: oklch(0.42 0.008 55);
            "
          >+506</span>
          <input
            type="tel"
            id="tel"
            name="tel"
            required
            class="form-input"
            style="border-radius: 0 2px 2px 0;"
            placeholder="8888 8888"
          />
        </div>
      </div>
    </div>

    <div class="form-field">
      <label for="message" class="form-label">Mensaje</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="form-input resize-none"
        placeholder="Contanos sobre tu evento: tipo, fecha, lugar, cantidad de personas..."
      ></textarea>
    </div>

    <div class="mt-2">
      <ThemedButton type="submit">
        Enviar mensaje
      </ThemedButton>
    </div>
  </form>
</div>

<!-- Toast feedback -->
<div
  id="success-message"
  class="fixed inset-0 flex items-center justify-center z-50 hidden"
  style="background: oklch(0.07 0.007 50 / 0.85);"
>
  <div
    class="max-w-sm w-full mx-4 p-8 text-center"
    style="background: oklch(0.16 0.013 50); border: 1px solid oklch(0.22 0.016 50); border-radius: 2px;"
  >
    <p class="font-serif mb-2" style="font-size: 1.3rem; color: oklch(0.83 0.155 72);">
      ¡Mensaje enviado!
    </p>
    <p class="font-sans mb-6" style="font-size: 0.9rem; color: oklch(0.67 0.010 65);">
      Muchas gracias. Te respondemos a la brevedad.
    </p>
    <button
      onclick="closeMessage('success-message')"
      class="font-sans px-6 py-2 transition-colors duration-200"
      style="
        font-size: 0.85rem;
        color: oklch(0.42 0.008 55);
        border: 1px solid oklch(0.22 0.016 50);
        border-radius: 2px;
        background: transparent;
        cursor: pointer;
      "
      onmouseover="this.style.color='oklch(0.83 0.155 72)'"
      onmouseout="this.style.color='oklch(0.42 0.008 55)'"
    >
      Cerrar
    </button>
  </div>
</div>

<div
  id="error-message"
  class="fixed inset-0 flex items-center justify-center z-50 hidden"
  style="background: oklch(0.07 0.007 50 / 0.85);"
>
  <div
    class="max-w-sm w-full mx-4 p-8 text-center"
    style="background: oklch(0.16 0.013 50); border: 1px solid oklch(0.22 0.016 50); border-radius: 2px;"
  >
    <p class="font-serif mb-2" style="font-size: 1.3rem; color: oklch(0.55 0.18 25);">
      Error al enviar
    </p>
    <p class="font-sans mb-6" style="font-size: 0.9rem; color: oklch(0.67 0.010 65);">
      Por favor intentá de nuevo o escribinos directo por WhatsApp.
    </p>
    <button
      onclick="closeMessage('error-message')"
      class="font-sans px-6 py-2 transition-colors duration-200"
      style="
        font-size: 0.85rem;
        color: oklch(0.42 0.008 55);
        border: 1px solid oklch(0.22 0.016 50);
        border-radius: 2px;
        background: transparent;
        cursor: pointer;
      "
      onmouseover="this.style.color='oklch(0.83 0.155 72)'"
      onmouseout="this.style.color='oklch(0.42 0.008 55)'"
    >
      Cerrar
    </button>
  </div>
</div>

<style>
  .form-label {
    display: block;
    font-family: var(--font-sans, system-ui);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: oklch(0.42 0.008 55);
    margin-bottom: 0.5rem;
  }

  .form-input {
    width: 100%;
    background: oklch(0.11 0.010 50);
    border: 1px solid oklch(0.22 0.016 50);
    border-radius: 2px;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans, system-ui);
    font-size: 0.9rem;
    color: oklch(0.94 0.010 75);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .form-input::placeholder {
    color: oklch(0.32 0.006 55);
  }

  .form-input:focus {
    border-color: oklch(0.72 0.170 50 / 0.5);
    box-shadow: 0 0 0 3px oklch(0.72 0.170 50 / 0.08);
  }

  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.4);
    cursor: pointer;
  }
</style>

<script is:inline>
  function handleSubmit(event) {
    event.preventDefault();
    const form = document.querySelector("#contact-form");
    const formData = new FormData(form);

    fetch("https://formspree.io/f/xblgqply", {
      method: "POST",
      body: formData,
      headers: { Accept: "application/json" },
    })
      .then((res) => {
        if (res.ok) {
          showMessage("success-message");
          form.reset();
        } else {
          showMessage("error-message");
        }
      })
      .catch(() => showMessage("error-message"));
  }

  function showMessage(id) {
    document.querySelector(`#${id}`)?.classList.remove("hidden");
  }

  function closeMessage(id) {
    document.querySelector(`#${id}`)?.classList.add("hidden");
  }
</script>
