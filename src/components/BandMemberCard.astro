---
import { Image } from "astro:assets";

const { image, name, instrument } = Astro.props;
---

<article class="group member-card reveal">
  <div class="relative overflow-hidden mb-4" style="border-radius: 2px;">
    <Image
      src={image || "/placeholder.svg"}
      alt={name}
      width={320}
      height={420}
      format="webp"
      quality={80}
      loading="lazy"
      sizes="(max-width: 640px) 100vw, 320px"
      class="w-full aspect-[3/4] object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
    />
    <!-- Subtle hover overlay — not a gradient stripe, just a tint -->
    <div
      class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      style="background: oklch(0.72 0.170 50 / 0.08);"
    >
    </div>
  </div>

  <div class="px-1">
    <h3 class="font-serif text-fob-text text-xl leading-tight mb-1">
      {name}
    </h3>
    <p
      class="font-sans text-fob-subtle text-sm tracking-wide uppercase"
      style="font-size: 0.75rem; letter-spacing: 0.08em;"
    >
      {instrument}
    </p>
  </div>
</article>
