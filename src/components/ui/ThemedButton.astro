---
import { cn } from "@/lib/utils";

const { href = null, type = "button", class: className, ...rest } = Astro.props;

const base = `
  inline-flex items-center justify-center gap-2
  px-8 py-3 rounded-sm
  border border-fob-amber/40 text-fob-gold
  font-sans font-medium tracking-wide text-base
  transition-all duration-300 ease-out
  hover:border-fob-amber hover:bg-fob-amber/10
  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fob-amber/50
  cursor-pointer
`;
---

{
  href ? (
    <a href={href} class={cn(base, className)} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cn(base, className)} {...rest}>
      <slot />
    </button>
  )
}
